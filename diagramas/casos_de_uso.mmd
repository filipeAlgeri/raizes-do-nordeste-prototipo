flowchart LR
    Cliente(["fa:fa-user Cliente"])
    Atendente(["fa:fa-user Atendente/Cozinha"])
    Gerente(["fa:fa-user Gerente"])
    Gateway(["fa:fa-globe Gateway de Pagamento (mock)"])

    subgraph ClienteUC[ ]
        UC1(Fazer login / cadastro)
        UC2(Consultar cardápio da unidade)
