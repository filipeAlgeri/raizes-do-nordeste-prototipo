        UC5(Atualizar status do pedido)
    end

    subgraph SistemaUC[ ]
        UC6(Processar pagamento mock)
    end

    Cliente --> UC1
    Cliente --> UC2
    Cliente --> UC3
    Cliente --> UC4

    Atendente --> UC5
    Gerente --> UC5

    UC3 -.include.-> UC6
